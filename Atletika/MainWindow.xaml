<Window x:Class="Atletika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atletika"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.6*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="0.4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Text="Atlétikai verseny" FontSize="20"/>
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Új versenyző" FontSize="13" Margin="0,5,0,0"/>
            <Label Content="Versenyző neve:"/>
            <TextBox Margin="5, 2"/>
            <Label Content="Versenyszám:"/>
            <ComboBox Margin="5, 0"/>

            <StackPanel Orientation="Horizontal">
                <Label Content="Nem:"/>
                <RadioButton Margin="15,0,0,0" Content="Férfi" VerticalContentAlignment="Center"/>
                <RadioButton Margin="30,0,0,0" Content="Nő" VerticalContentAlignment="Center" IsChecked="True"/>
            </StackPanel>
            <DockPanel LastChildFill="False">
                <Label Content="Életkor" DockPanel.Dock="Left"/>
                <TextBlock Margin="5,0" VerticalAlignment="Center" Text="{Binding ElementName=sli_eletkor, Path=Value, StringFormat={}{0} év}" DockPanel.Dock="Right"/>
            </DockPanel>
            <Slider x:Name="sli_eletkor" Minimum="18" Maximum="90" Value="25" IsSnapToTickEnabled="True" TickFrequency="1"/>
            <Label Content="Korábbi eredmények"/>
            <CheckBox Content="Olimpiai csúcs" Margin="5,0,0,5"/>
            <CheckBox Content="Világbajnoki csúcs" Margin="5,0,0,5" IsChecked="True"/>
            <CheckBox Content="Európai csúcs" Margin="5,0,0,5"/>
            <DockPanel>
                <Label Content="Igényelt rajtszám:" DockPanel.Dock="Left"/>
                <TextBox DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBlock Text="Üres mező: automatikus kiosztás." FontSize="10"/>
            <Button Content="Regisztrál" Margin="5"/>
        </StackPanel>
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" LastChildFill="False">
            <Label DockPanel.Dock="Left" Content="Regisztrált versenyzők:"/>
            <Button DockPanel.Dock="Right" Content="FÁJLBA MENTÉS" Margin="5,3,5,3"/>
            <Button DockPanel.Dock="Right" Content="FÁJLBÓL BETÖLTÉS" Margin="5,3,5,3"/>
        </DockPanel>

        <StackPanel Grid.Column="1" Grid.Row="1">
            <Label Content="Regisztrált versenyzők"/>
        </StackPanel>
    </Grid>
</Window>
